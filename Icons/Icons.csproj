<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Comentality.Icons</AssemblyName>
    <!-- The namespace stays Icons: it is what the embedded library resource is named
         after, and it is internal to the assembly anyway. The file name is not, and
         every XrmToolBox tool shares one Plugins folder. -->
    <RootNamespace>Icons</RootNamespace>
    <Version>1.1.0</Version>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Company>Comentality</Company>
    <Authors>Comentality</Authors>
    <Description>Put a proper icon on a Dataverse table: pick one from six bundled icon libraries, and the tool uploads and publishes it. Searches Fluent, Phosphor, Lucide, Tabler, Font Awesome and Solar icons, writes the SVG web resource, points the table at it and publishes, all without leaving XrmToolBox.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NuspecFile>Icons.nuspec</NuspecFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The About box's version parsing and diagnostics line are checked by the tests. -->
    <InternalsVisibleTo Include="Icons.Tests" />
    <!-- And the harness opens the About box without a modal loop, to photograph it. -->
    <InternalsVisibleTo Include="Icons.UiHarness" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.7.71">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Zip is in the framework on net48, but only behind an explicit reference. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- And so is the HTTP client the stock icons are read with. The only host it is ever
         pointed at is the org this tool is already connected to. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon library travels inside the assembly. tools\build-catalog.ps1 rebuilds it. -->
    <EmbeddedResource Include="Catalog\icons.zip" />
    <!-- And so does the org mark on the About button. tools\make-house-mark.ps1 rebuilds it
         from the brand repository, which is where the logo is actually decided. -->
    <EmbeddedResource Include="About\comentality-16.png" />
  </ItemGroup>
</Project>
