# The private XrmToolBox instance xtb.ps1 builds, including its connection and token cache.
tests/.xtb/
tests/.ui/
tests/Icons.UiHarness/.ui/
tests/.slow/
# The e2e run's shots and its borrowed token cache, which is a sign in and must never be committed.
tests/.e2e/

# Measurements come from a real org: screenshots and the JSON both carry its URL and its
# data. Kept locally by default. Un-ignore if the org they came from is a demo one.
docs/ui-measurements/*.png
docs/ui-measurements/*.json
